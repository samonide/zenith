            "fgDark": "#4a4a4a"
        },
        "syntax": {
            "blue": "#6079a8",
            "cyan": "#5a8c94",
            "green": "#608768",
            "purple": "#7d6890",
            "orange": "#90795c",
            "red": "#90646b",
            "yellow": "#90875c",
            "pink": "#906890",
            "lavender": "#6e6090",
            "peach": "#907459",
            "mint": "#609079",
